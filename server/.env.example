# This file is optional: the app runs fine without it.
# Copy it to .env only if you want to change these defaults.

# Optional. If not set, a random secret is generated and saved in data/.jwt-secret.
# JWT_SECRET=

# First owner account, created automatically the first time the app starts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Where the database file is kept (relative to the server folder).
# Back up your data by copying this file.
DB_FILE=data/savannah.db

PORT=4000
