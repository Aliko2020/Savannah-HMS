# Postgres connection string. Get a free one from https://neon.tech (Dashboard -> Connection string).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign login tokens. Change this!
JWT_SECRET=change-me-to-a-long-random-string

# First owner account, created automatically the first time the app starts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Your shop's timezone, so daily reports match your clock. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: Africa/Nairobi, Africa/Lagos, America/New_York
APP_TIMEZONE=UTC

PORT=4000
